{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "url": {
      "anyOf": [
        {
          "type": "string",
          "const": "built-in"
        },
        {
          "type": "string",
          "format": "uri"
        }
      ]
    },
    "request": {
      "type": "object",
      "properties": {
        "method": {
          "default": "GET",
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "headers": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "body": {
          "default": "",
          "type": "string"
        }
      }
    },
    "properties": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "origin": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            }
          },
          "required": [
            "url"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "builtIn": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 599
                },
                "headers": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^[^\\r\\n\\0]*$"
                  }
                },
                "body": {
                  "type": "string"
                },
                "bodyFile": {
                  "type": "string",
                  "minLength": 1
                },
                "files": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false,
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "body",
                      "bodyFile"
                    ]
                  },
                  {
                    "required": [
                      "body",
                      "files"
                    ]
                  },
                  {
                    "required": [
                      "bodyFile",
                      "files"
                    ]
                  },
                  {
                    "required": [
                      "files",
                      "status"
                    ]
                  }
                ]
              }
            }
          },
          "required": [
            "builtIn"
          ],
          "additionalProperties": false
        }
      ]
    },
    "client": {
      "type": "object",
      "properties": {
        "preset": {
          "type": "string",
          "enum": [
            "de",
            "nl",
            "us"
          ]
        },
        "ip": {
          "type": "string"
        },
        "asn": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "countryName": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "continent": {
          "type": "string"
        },
        "lat": {
          "type": "string"
        },
        "long": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "properties": {
        "preset": {
          "type": "string",
          "enum": [
            "de",
            "nl",
            "us"
          ]
        },
        "dc": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "hostname": {
          "type": "string"
        },
        "popLat": {
          "type": "string"
        },
        "popLong": {
          "type": "string"
        },
        "popReg": {
          "type": "string"
        },
        "popCity": {
          "type": "string"
        },
        "popContinent": {
          "type": "string"
        },
        "popCountryCode": {
          "type": "string"
        },
        "popCountryName": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "url"
  ]
}
