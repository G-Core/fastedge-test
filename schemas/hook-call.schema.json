{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/HookCall",
  "definitions": {
    "HookCall": {
      "type": "object",
      "properties": {
        "hook": {
          "type": "string"
        },
        "context": {
          "$ref": "#/definitions/RequestContext",
          "description": "Client and edge for this call only (see `RunnerConfig.client` / `.edge`); default: the runner's."
        },
        "request": {
          "type": "object",
          "properties": {
            "headers": {
              "$ref": "#/definitions/HeaderRecord"
            },
            "body": {
              "type": "string"
            },
            "method": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "scheme": {
              "type": "string"
            }
          },
          "required": [
            "headers",
            "body"
          ]
        },
        "response": {
          "type": "object",
          "properties": {
            "headers": {
              "$ref": "#/definitions/HeaderRecord"
            },
            "body": {
              "type": "string"
            },
            "status": {
              "type": "number"
            },
            "statusText": {
              "type": "string"
            }
          },
          "required": [
            "headers",
            "body"
          ],
          "description": "Seed state for the response hooks (`onResponseHeaders` / `onResponseBody`) when calling them in isolation via `callHook()`. The full-flow path (`callFullFlow`) generates the upstream response at runtime and does not consume this field — request hooks ignore it, and response hooks are called with the response built from the live origin fetch or built-in responder output."
        },
        "properties": {
          "type": "object",
          "additionalProperties": {}
        },
        "enforceProductionPropertyRules": {
          "type": "boolean"
        }
      },
      "required": [
        "hook",
        "request",
        "properties"
      ]
    },
    "RequestContext": {
      "type": "object",
      "properties": {
        "client": {
          "$ref": "#/definitions/ClientContext"
        },
        "edge": {
          "$ref": "#/definitions/EdgeContext"
        }
      }
    },
    "ClientContext": {
      "type": "object",
      "properties": {
        "preset": {
          "$ref": "#/definitions/Preset"
        },
        "ip": {
          "type": "string"
        },
        "asn": {
          "type": "string"
        },
        "country": {
          "type": "string",
          "description": "ISO country code (`DE`)."
        },
        "countryName": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "region": {
          "type": "string",
          "description": "Region / state code (`HE`)."
        },
        "continent": {
          "type": "string",
          "description": "Continent code (`EU`)."
        },
        "lat": {
          "type": "string"
        },
        "long": {
          "type": "string"
        }
      }
    },
    "Preset": {
      "type": "string",
      "enum": [
        "de",
        "nl",
        "us"
      ]
    },
    "EdgeContext": {
      "type": "object",
      "properties": {
        "preset": {
          "$ref": "#/definitions/Preset"
        },
        "dc": {
          "type": "string",
          "description": "POP code (`fr5`); also the cache bucket."
        },
        "region": {
          "type": "string",
          "description": "Dictionary region (`eu`)."
        },
        "country": {
          "type": "string",
          "description": "Dictionary country name (`Germany`)."
        },
        "city": {
          "type": "string"
        },
        "hostname": {
          "type": "string",
          "description": "Edge node name (`fr5-hw-edge-gpig-gc23`); CDN apps also get it as `X-ID`."
        },
        "popLat": {
          "type": "string",
          "description": "`pop-*` headers (HTTP apps)."
        },
        "popLong": {
          "type": "string"
        },
        "popReg": {
          "type": "string"
        },
        "popCity": {
          "type": "string"
        },
        "popContinent": {
          "type": "string"
        },
        "popCountryCode": {
          "type": "string"
        },
        "popCountryName": {
          "type": "string"
        }
      }
    },
    "HeaderRecord": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ]
      }
    }
  }
}
