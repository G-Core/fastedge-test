{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/FullFlowResult",
  "definitions": {
    "FullFlowResult": {
      "type": "object",
      "properties": {
        "hookResults": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/HookResult"
          }
        },
        "finalResponse": {
          "type": "object",
          "properties": {
            "status": {
              "type": "number"
            },
            "statusText": {
              "type": "string"
            },
            "headers": {
              "$ref": "#/definitions/HeaderRecord"
            },
            "body": {
              "type": "string"
            },
            "contentType": {
              "type": "string"
            },
            "isBase64": {
              "type": "boolean"
            }
          },
          "required": [
            "status",
            "statusText",
            "headers",
            "body",
            "contentType"
          ]
        },
        "calculatedProperties": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "required": [
        "hookResults",
        "finalResponse"
      ]
    },
    "HookResult": {
      "type": "object",
      "properties": {
        "returnCode": {
          "type": [
            "number",
            "null"
          ]
        },
        "logs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "level": {
                "type": "number"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "level",
              "message"
            ]
          }
        },
        "input": {
          "type": "object",
          "properties": {
            "request": {
              "type": "object",
              "properties": {
                "headers": {
                  "$ref": "#/definitions/HeaderRecord"
                },
                "body": {
                  "type": "string"
                }
              },
              "required": [
                "headers",
                "body"
              ]
            },
            "response": {
              "type": "object",
              "properties": {
                "headers": {
                  "$ref": "#/definitions/HeaderRecord"
                },
                "body": {
                  "type": "string"
                }
              },
              "required": [
                "headers",
                "body"
              ]
            },
            "properties": {
              "type": "object",
              "additionalProperties": {}
            }
          },
          "required": [
            "request",
            "response"
          ]
        },
        "output": {
          "type": "object",
          "properties": {
            "request": {
              "type": "object",
              "properties": {
                "headers": {
                  "$ref": "#/definitions/HeaderRecord"
                },
                "body": {
                  "type": "string"
                }
              },
              "required": [
                "headers",
                "body"
              ]
            },
            "response": {
              "type": "object",
              "properties": {
                "headers": {
                  "$ref": "#/definitions/HeaderRecord"
                },
                "body": {
                  "type": "string"
                }
              },
              "required": [
                "headers",
                "body"
              ]
            },
            "properties": {
              "type": "object",
              "additionalProperties": {}
            }
          },
          "required": [
            "request",
            "response"
          ]
        },
        "properties": {
          "type": "object",
          "additionalProperties": {}
        },
        "storeCalls": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/StoreCall"
          },
          "description": "The cache / Edge KV calls this hook made, in order (stores on only)."
        }
      },
      "required": [
        "returnCode",
        "logs",
        "input",
        "output",
        "properties"
      ]
    },
    "HeaderRecord": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ]
      }
    },
    "StoreCall": {
      "type": "object",
      "properties": {
        "app": {
          "type": "string",
          "enum": [
            "cdn",
            "http"
          ]
        },
        "hook": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "cache",
            "kv"
          ]
        },
        "op": {
          "type": "string"
        },
        "dc": {
          "type": "string",
          "description": "Cache bucket (cache calls)."
        },
        "store": {
          "type": "string",
          "description": "Edge KV store (KV calls)."
        },
        "key": {
          "type": "string"
        },
        "pattern": {
          "type": "string"
        },
        "prefix": {
          "type": "string"
        },
        "result": {
          "type": "string",
          "description": "`ok`, or the service's error (`wrong-type`, `invalid-pattern`, ...)."
        },
        "value": {
          "type": "string",
          "description": "The result value: a count, a flag, or the size of a value or list."
        },
        "at": {
          "type": "number",
          "description": "Wall-clock time (ms since epoch)."
        }
      },
      "required": [
        "app",
        "kind",
        "op",
        "result",
        "at"
      ]
    }
  }
}
